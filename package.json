{
  "name": "github-actions-gate",
  "version": "1.0.0",
  "description": "CI/CD readiness gate for GitHub Actions — block merges until PRs pass tests, lint, coverage, and conflict checks.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test test/index.test.ts",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "github-actions",
    "ci",
    "cd",
    "gate",
    "merge",
    "pr"
  ],
  "license": "MIT"
}
